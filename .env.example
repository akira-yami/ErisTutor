# ====================================================================
# ErisTutor — File cấu hình môi trường (.env)
# ====================================================================
# Sao chép tệp này thành .env để tùy chỉnh runtime trên máy cục bộ.
# Thứ tự ưu tiên nạp biến: Biến môi trường hệ thống (OS) > .env > config/secrets.json

# --------------------------------------------------------------------
# 1. BỘ NÃO NHẬN THỨC CHÍNH (DeepSeek / Whale2API)
# --------------------------------------------------------------------
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek
ERIS_REMOTE_BASE_URL=https://api.deepseek.com
ERIS_REMOTE_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Whale2API (Proxy DeepSeek Web 896K context):
# Bật = 1 nếu bạn muốn dùng Whale2API cục bộ trên port 6011
ERIS_DS2API_ENABLED=0
ERIS_DS2API_BASE_URL=http://127.0.0.1:6011/v1
ERIS_DS2API_MODEL=deepseek-chat
ERIS_DS2API_PORTS=6011
# Thinking configuration: Root thinking ON (suy ngẫm sâu), Surface Writer thinking OFF (sinh lời siêu tốc)
ERIS_EXECUTIVE_THINKING_DISABLED=0
ERIS_SURFACE_THINKING_DISABLED=1

# --------------------------------------------------------------------
# 2. GIÁC QUAN THỊ GIÁC (Google Gemini Vision)
# --------------------------------------------------------------------
# Gemini dùng để trích xuất ngữ cảnh màn hình và nhận diện hình ảnh
GEMINI_API_KEY=
ERIS_VISION_API_ENABLED=auto
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=60

# --------------------------------------------------------------------
# 3. GIỌNG NÓI & TTS (Text-to-Speech)
# --------------------------------------------------------------------
# Nhà cung cấp TTS mặc định: edge-tts (miễn phí, tự nhiên) hoặc elevenlabs
ERIS_TTS_ENABLED=1
ERIS_TTS_PROVIDER=edge-tts
ERIS_TTS_LANGUAGE=vi

# Nếu dùng ElevenLabs (chất lượng cao / voice clone):
ELEVENLABS_API_KEY=
ERIS_ELEVENLABS_VOICE_ID=
ERIS_ELEVENLABS_MODEL=eleven_v3

# --------------------------------------------------------------------
# 4. KẾT NỐI GODOT BODY (UDP Transport)
# --------------------------------------------------------------------
ERIS_UDP_RECEIVE_PORT=4242
ERIS_UDP_SEND_PORT=4243
ERIS_HOST=127.0.0.1

# --------------------------------------------------------------------
# 5. BỘ NHỚ & EMBEDDING (Memory Indexing)
# --------------------------------------------------------------------
# Tắt embedding model local để tăng tốc tối đa (dùng lexical matching thuần)
ERIS_EMBEDDING_ENABLED=0
ERIS_SEMANTIC_BACKEND=fallback

