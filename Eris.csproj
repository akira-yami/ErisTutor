<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="src/body/richchat/**/*" Exclude="src/body/richchat/**/*.txt" />
    <Compile Remove="src\UdpListener.cs;src\integration\body_contracts\**" />
    <Compile Remove="dist\**;build\**;scratch\**" />
  </ItemGroup>
  <Target Name="SyncExportDataAssembly" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="data_Eris_windows_x86_64" Condition="Exists('data_Eris_windows_x86_64')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="data_Eris_windows_x86_64" Condition="Exists('data_Eris_windows_x86_64') and Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
