{
  "manifest_version": 3,
  "name": "ERIS Chess.com Bridge",
  "version": "1.0.0",
  "description": "Streams Chess.com board snapshots to the local ERIS companion runtime.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ERIS Chess Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
