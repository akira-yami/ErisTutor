{
  "_readme": "Cấu hình bảo mật và API keys cho ErisTutor. Sao chép tệp này thành 'config/secrets.json' và điền API key thực tế của bạn. Tuyệt đối không commit secrets.json lên Git.",
  "api_keys": {
    "DEEPSEEK_API_KEY": "",
    "ERIS_DS2API_BASE_URL": "http://127.0.0.1:6011/v1",
    "ERIS_DS2API_API_KEY": "",
    "GEMINI_API_KEY": "",
    "ELEVENLABS_API_KEY": ""
  },
  "providers": {
    "deepseek": {
      "default": {
        "base_url": "https://api.deepseek.com",
        "model": "deepseek-chat",
        "api_key": ""
      },
      "whale2api": {
        "base_url": "http://127.0.0.1:6011/v1",
        "model": "deepseek-chat",
        "api_key": ""
      }
    },
    "gemini": {
      "default": {
        "model": "gemini-2.5-flash",
        "api_key": ""
      }
    }
  },
  "env": {
    "ERIS_REMOTE_PROVIDER": "deepseek",
    "ERIS_REMOTE_MODEL": "deepseek-chat",
    "ERIS_TTS_PROVIDER": "edge-tts",
    "ERIS_TTS_LANGUAGE": "vi"
  }
}
