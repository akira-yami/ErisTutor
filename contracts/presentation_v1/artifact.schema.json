{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eris:artifact:v1",
  "title": "Eris ArtifactEnvelope v1",
  "type": "object",
  "required": ["schema", "artifact_id", "turn_id", "kind", "revision", "source", "content", "presentation"],
  "properties": {
    "schema": {"const": "eris.artifact.v1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "turn_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["math", "chart", "code", "table", "document", "speech"]},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "source": {"$ref": "#/$defs/id"},
    "content": {"type": "object"},
    "presentation": {
      "type": "object", "required": ["target", "order"],
      "properties": {
        "target": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["rich_chat", "workspace", "bubble", "tts"]}},
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "maxLength": 200}
      }
    },
    "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "math"}}}, "then": {"properties": {"content": {"required": ["latex"], "properties": {"latex": {"type": "string", "minLength": 1, "maxLength": 8000}}}}}},
    {"if": {"properties": {"kind": {"const": "chart"}}}, "then": {"properties": {"content": {"required": ["chart_type", "series"], "properties": {"chart_type": {"type": "string"}, "series": {"type": "array", "minItems": 1}}}}}},
    {"if": {"properties": {"kind": {"const": "code"}}}, "then": {"properties": {"content": {"required": ["language", "source"], "properties": {"language": {"type": "string"}, "source": {"type": "string"}}}}}},
    {"if": {"properties": {"kind": {"const": "table"}}}, "then": {"properties": {"content": {"required": ["columns", "rows"], "properties": {"columns": {"type": "array"}, "rows": {"type": "array"}}}}}},
    {"if": {"properties": {"kind": {"const": "document"}}}, "then": {"properties": {"content": {"required": ["format", "source"], "properties": {"format": {"enum": ["markdown", "text", "blocks"]}, "source": {"type": "string", "maxLength": 48000}, "blocks": {"type": "array", "maxItems": 120}}}}}},
    {"if": {"properties": {"kind": {"const": "speech"}}}, "then": {"properties": {"content": {"required": ["text", "voice_text", "sync_group", "interruptible"], "properties": {"text": {"type": "string"}, "voice_text": {"type": "string"}, "sync_group": {"type": "string"}, "interruptible": {"type": "boolean"}}}}}}
  ],
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9_:/\\.\\-]+$"}}
}
